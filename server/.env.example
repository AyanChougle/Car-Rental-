# ============================================================
# KRUIZLY HOSTINGER PRODUCTION CONFIGURATION (.env)
# ============================================================

PORT=4001
NODE_ENV=production

# Frontend Origin(s) allowed to communicate with the API
ALLOWED_ORIGINS=https://ayanchougle.github.io,https://kruizly.com,http://localhost:5500,http://localhost:5501

# ============================================================
# HOSTINGER MYSQL DATABASE
# ============================================================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=u123456789_kruizly
MYSQL_USER=u123456789_kruizly_user
MYSQL_PASSWORD=YourStrongDatabasePassword123!
MYSQL_CONNECTION_LIMIT=15

# ============================================================
# HOSTINGER FILE STORAGE (UPLOAD_ROOT)
# Absolute path to directory on the server where uploads are kept
# e.g., /home/u123456789/domains/kruizly.com/storage/uploads
# ============================================================
MEDIA_UPLOAD_DIR=./uploads

# ============================================================
# FIREBASE AUTHENTICATION (TOKEN VERIFICATION ONLY)
# Paste the base64-encoded service account JSON or provide serviceAccountKey.json
# ============================================================
FIREBASE_SERVICE_ACCOUNT_BASE64=

# ============================================================
# SMTP EMAIL DELIVERY (INVOICES & NOTIFICATIONS)
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=carrentpedatabase@gmail.com
SMTP_PASS=ydgallypuahfjnrc
SMTP_FROM=carrentpedatabase@gmail.com
COMPANY_NAME=KRUIZLY
COMPANY_EMAIL=carrentpedatabase@gmail.com

# ============================================================
# PUPPETEER CHROMIUM PATH (LINUX HOSTINGER VPS / CLOUD)
# ============================================================
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
