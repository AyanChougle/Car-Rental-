rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function isManagerOrAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["admin", "manager", "executive"];
    }

    function isExecutive() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "executive";
    }

    // users/{uid}
    // - Owner can read their own doc; staff can read all (needed for
    //   Manager summaries and Executive operations).
    // - Owner can create their own doc on signup (role is forced to
    //   "customer" here so a crafted direct write can't self-signup as
    //   staff), and can update their own profile fields (name, phone, age,
    //   license/aadhar upload URLs) — but NEVER their own role,
    //   licenseStatus, or aadharStatus. Those are privilege fields and
    //   self-granting them was a real vulnerability in an earlier version
    //   of this app (a "Grant Admin" button wrote role: "admin" straight
    //   to the signed-in user's own doc). Only an admin can change role;
    //   only a manager or admin can change license/aadhar verification
    //   status.
    match /users/{uid} {
      allow read: if isOwner(uid) || isManagerOrAdmin();
      allow create: if isOwner(uid) && request.resource.data.role == "customer";

      allow update: if isOwner(uid)
        && request.resource.data.role == resource.data.role
        && (
          request.resource.data.licenseStatus == resource.data.licenseStatus
          || request.resource.data.licenseStatus == "pending"
        )
        && (
          request.resource.data.aadharStatus == resource.data.aadharStatus
          || request.resource.data.aadharStatus == "pending"
        )
        && (
          request.resource.data.get("panStatus", "not_submitted")
            == resource.data.get("panStatus", "not_submitted")
          || request.resource.data.get("panStatus", "not_submitted") == "pending"
        );

      allow update: if isAdmin();
    }

    // bookings/{bookingId} — owner can create their own booking and cancel
    // it later; staff can read all, while Executive operational updates are
    // field-limited below and Admin retains full control.
    // Payment fields are field-restricted: the owner can submit a UPI
    // reference/screenshot (which only ever moves paymentStatus to
    // "pending_verification") and can cancel their own booking (status ->
    // "cancelled"), but can never set their own paymentStatus to "paid" or
    // "rejected", or flip status to "confirmed"/"completed" — those require
    // a staff review from the Admin/Manager Payments or Bookings tab.
    // returnInspection, totalAmount, and securityDeposit are locked to
    // their existing value on an owner update — those are the damage/
    // deposit-deduction record set by staff when a car is returned, and a
    // customer directly editing their own deposit deduction would defeat
    // the entire point of that record.
    match /bookings/{bookingId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isManagerOrAdmin());

      allow update: if isSignedIn() && resource.data.userId == request.auth.uid
        && (request.resource.data.status == resource.data.status
            || request.resource.data.status == "cancelled")
        && (request.resource.data.paymentStatus == resource.data.paymentStatus
            || request.resource.data.paymentStatus == "pending_verification")
        && request.resource.data.get("returnInspection", null) == resource.data.get("returnInspection", null)
        && request.resource.data.get("totalAmount", null) == resource.data.get("totalAmount", null)
        && request.resource.data.get("securityDeposit", null) == resource.data.get("securityDeposit", null);

      // Executives handle physical operations only. They cannot modify
      // payment, pricing, ownership, or customer identity fields.
      allow update: if isExecutive()
        && (
          request.resource.data.status == resource.data.status
          || request.resource.data.status == "cancelled"
          || (
            resource.data.status == "confirmed"
            && request.resource.data.status == "completed"
          )
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "pickupStatus",
          "pickupAt",
          "pickupHandledBy",
          "pickupNotes",
          "pickupPhotoMediaIds",
          "returnInspection",
          "odometerStart",
          "odometerEnd",
          "odometerUpdatedAt",
          "fastagStart",
          "fastagReturn",
          "fastagUpdatedAt",
          "fastagUpdatedBy",
          "updatedAt"
        ]);

      allow update, delete: if isAdmin();
    }

    // partner_cars/{carId} — signed-in users can list their own car and
    // edit/withdraw it later; admins/managers approve/reject and add
    // professional photos once approved. The owner can edit their own
    // listing's details but can never set their own status to "approved"
    // (that would let a host self-approve, bypassing review entirely) or
    // touch the photos array (those are staff-uploaded via the Admin
    // Host Car Listings tab, not something the host writes directly).
    match /partner_cars/{carId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);

      allow update: if isSignedIn() && resource.data.userId == request.auth.uid
        && request.resource.data.status == resource.data.status
        && request.resource.data.get("photos", null) == resource.data.get("photos", null)
        && request.resource.data.get("photoMediaIds", null) == resource.data.get("photoMediaIds", null);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow update, delete: if isAdmin();
    }

    // contact_messages/{id} — public contact form, no login required to send;
    // only staff can read the inbox.
    match /contact_messages/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // vehicles/{regNo} stores Admin-controlled availability overrides for
    // the static catalog. Public reads keep fleet/booking availability live;
    // only Admin can change an override.
    match /vehicles/{regNo} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // payments/{paymentId} — Phase 3 Firestore mirror of the SQLite
    // payments table (server/services/firestorePaymentSync.js). Written
    // ONLY by the Admin SDK on the server (which bypasses these rules
    // entirely), never by a client directly — so this only needs to
    // govern reads. The owner can see their own payment status; a client
    // write attempt is always denied, matching Section 12's "the customer
    // cannot mark payment verified."
    match /payments/{paymentId} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isManagerOrAdmin());
      allow write: if false;
    }

    // vehicleMaintenance/{maintenanceId} — service/RC/insurance/PUC records
    // per vehicle (Master Plan Section 7). Not customer-facing at all:
    // only staff need to see or log service history, expiry dates, and
    // maintenance cost. No public read, unlike vehicles/{regNo}.
    match /vehicleMaintenance/{maintenanceId} {
      allow read: if isManagerOrAdmin();
      allow create: if isManagerOrAdmin()
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isManagerOrAdmin();
    }

    // coupons/{couponId} — public read for customers during checkout; write for staff/admin
    match /coupons/{couponId} {
      allow read: if true;
      allow create, update, delete: if isManagerOrAdmin() || isAdmin();
    }

    // couponUsage/{usageId} — customer reads their own usage records; creation during confirmed booking
    match /couponUsage/{usageId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isManagerOrAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}
